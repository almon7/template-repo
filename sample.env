# Dockerfile args
UID=1000
GID=1000

# Application port
APP_PORT=8000

# Log level (TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application environment: development (default), testing (skip slow startup tasks like DB migrations in CI/pytest), or production.
# In production, Swagger UI is disabled, debug log levels are forbidden, and ALLOWED_HOSTS must be set.
ENVIRONMENT=development

# Allowed HTTP Host header values (TrustedHostMiddleware).
# In production this must be set to your actual domain(s) — wildcards are rejected.
# Provide a JSON array: ALLOWED_HOSTS=["api.example.com","www.example.com"]
# ALLOWED_HOSTS=["*"]